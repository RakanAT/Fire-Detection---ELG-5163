# Template for CDSE (Copernicus Data Space Ecosystem) OAuth client credentials.
# Copy this file to config/authentication.env and fill in your own values:
#     copy config\authentication.env.example config\authentication.env
# Create credentials at https://shapps.dataspace.copernicus.eu/dashboard/ -> User settings -> OAuth clients.
# config/authentication.env is git-ignored; never commit real credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
